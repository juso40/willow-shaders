[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/material_files.gd" id="1"]

[node name="MaterialFiles" type="Node"]
script = ExtResource("1")

[node name="ImportDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import model"
file_mode = 0
access = 2
filters = PackedStringArray("*.glb ; Model")

[node name="OpenStateDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Open state"
file_mode = 0
access = 2
filters = PackedStringArray("*.res ; Godot resource", "*.tres ; Godot text resource")

[node name="StateSaveDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Save state"
access = 2
current_file = "material_state.res"
filters = PackedStringArray("*.res ; Godot resource", "*.tres ; Godot text resource")

[node name="DumpDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Export parameters"
access = 2
filters = PackedStringArray("*.txt ; Parameters")

[connection signal="file_selected" from="ImportDialog" to="." method="import_model"]
[connection signal="file_selected" from="OpenStateDialog" to="." method="load_state"]
[connection signal="file_selected" from="StateSaveDialog" to="." method="_on_state_save_selected"]
[connection signal="file_selected" from="DumpDialog" to="." method="save_dump"]
